{
  "name": "synapse",
  "version": "0.1.0",
  "description": "Universal AI Agent Execution & Orchestration Platform",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "synapse": "./dist/cli/main.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli/main.ts",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "pino": "^10.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/node": "^22.0.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^4.0.0"
  }
}
